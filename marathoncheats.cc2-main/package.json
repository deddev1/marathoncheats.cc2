{
  "name": "marathoncheats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "validate:sitemap": "tsx scripts/validate-sitemap.ts",
    "validate:seo": "tsx scripts/validate-seo.ts",
    "validate:seo:prerendered": "VALIDATE_PRERENDERED_META=1 tsx scripts/validate-seo.ts",
    "prerender": "tsx scripts/prerender.ts",
    "generate:video-metadata": "tsx scripts/generate-video-metadata.ts",
    "generate:video-sitemap": "tsx scripts/generate-video-sitemap.ts",
    "generate:image-sitemap": "tsx scripts/generate-image-sitemap.ts",
    "validate:video-sitemap": "tsx scripts/validate-video-sitemap.ts",
    "validate:image-sitemap": "tsx scripts/validate-image-sitemap.ts",
    "validate:canonical-redirects": "tsx scripts/validate-canonical-redirects.ts",
    "validate:no-dist-headers": "tsx scripts/validate-no-dist-headers.ts",
    "prepare:cloudflare-deploy": "tsx scripts/prepare-cloudflare-deploy.ts",
    "fetch:ign-images": "node scripts/fetch-ign-marathon-images.mjs",
    "convert:images-webp": "node scripts/convert-images-to-webp.mjs",
    "generate:image-dimensions": "tsx scripts/generate-image-dimensions.ts",
    "validate:image-optimizer": "tsx scripts/validate-image-optimizer.ts",
    "validate:h1-content": "tsx scripts/validate-h1-content.ts",
    "build": "npm run convert:images-webp && npm run generate:image-dimensions && npm run generate:video-metadata && npm run generate:sitemap && npm run generate:video-sitemap && npm run generate:image-sitemap && npm run validate:sitemap && npm run validate:video-sitemap && npm run validate:image-sitemap && npm run validate:image-optimizer && npm run validate:canonical-redirects && tsc -b && npm run typecheck:worker && vite build && npm run validate:seo && npm run validate:no-dist-headers && npm run prerender && npm run validate:seo:prerendered && npm run validate:h1-content && npm run prepare:cloudflare-deploy",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run prepare:cloudflare-deploy && wrangler deploy"
  },
  "dependencies": {
    "@porsche-design-system/components-react": "^3.33.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react-router-dom": "^5.3.3",
    "lenis": "^1.3.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.35.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wrangler": "^4.113.0"
  }
}
