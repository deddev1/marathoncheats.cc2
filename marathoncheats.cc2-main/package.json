{
	"name": "marathon-cheats",
	"type": "module",
	"version": "1.0.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"sync:brand": "node scripts/sync-brand.mjs",
		"prebuild": "node scripts/sync-brand.mjs && node scripts/optimize-responsive-images.mjs",
		"build": "astro build",
		"postbuild": "node scripts/strip-brand-studio.mjs",
		"build:validate": "npm run sync:brand && astro build && node scripts/strip-brand-studio.mjs && node scripts/validate-sitemaps.mjs",
		"optimize:images": "node scripts/optimize-responsive-images.mjs",
		"fetch:images": "node scripts/fetch-tarkov-images.mjs",
		"generate:brand": "node scripts/generate-brand-assets.mjs",
		"preview": "astro preview",
		"validate:sitemaps": "node scripts/validate-sitemaps.mjs",
		"generate:i18n": "node scripts/generate-i18n-content.mjs",
		"deploy": "npm run build && wrangler deploy",
		"pages:deploy": "wrangler pages deploy dist --project-name=marathoncheats2",
		"astro": "astro"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/syne": "^5.2.7",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "^7.0.9",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"sharp": "^0.35.3",
		"terser": "^5.49.0",
		"wrangler": "^4.30.0"
	}
}
